@page "/"

@inject ICategoryRepository _categoryRepository
@inject IProductRepository _productRepository
@inject IShoppingCartRepository _cartRepository
@inject SharedStateService _sharedStateService
@inject AuthenticationStateProvider _authenticationStateProvider
@inject NavigationManager _navigationManager
@inject IJSRuntime _js

<PageTitle>Home</PageTitle>
@if (isProcessing)
{
    <div class="position-absolute d-flex flex-column align-items-center justify-content-center vh-100 w-100 bg-white">
        <img src="./images/loading.gif" alt="loading" />
    </div>
}
else
{
    <div class="container-fluid full-width m-0 px-0">
        <div class="jumbotron-custom">
            <div class="d-flex align-items-center m-auto" style="width: 400px; height: 50vh;">
                
                <div class="d-flex align-items-center" style="width: 100%;">
                    <input type="text" class="form-control rounded-pill"
                           @bind:event="oninput" @bind:get="searchText" @bind:set="searchByProdName"
                           placeholder="Search for Food Items!"
                           style="width: 100%; padding: 20px;">
                    <span style="position: relative; left: -43px;"><i class="bi bi-search"></i></span>
                </div>
            </div>
        </div>
        <div class="content m-2 px-4">
            <ul class="nav nav-underline justify-content-center mb-2">
                <li class="nav-item">
                    <span class="nav-link @getActiveTabClass(0)" href="#" style="cursor: pointer" @onclick="() => filteredProducts(0)">All</span>
                </li>
                @foreach (var category in Categories)
                {
                    <li class="nav-item">
                        <span class="nav-link @getActiveTabClass(category.Id)" href="#" style="cursor: pointer" @onclick="() => filteredProducts(category.Id)">@category.Name</span>
                    </li>
                }
            </ul>
            <div class="row mx-1 mt-4">
                @foreach (var prod in FilteredProducts)
                {
                    <div class="col-md-6 col-lg-4 col-12 mb-5 pe-3">
                        <div class="card">
                            <div class="row mt-3 mb-2">
                                @if (!string.IsNullOrEmpty(prod.SpecialTag))
                                {
                                    <div class="col-6 px-3">
                                        <i class="bi bi-star btn btn-outline-success disabled"> @prod.SpecialTag</i>
                                    </div>
                                }
                                <div class="col-6 px-3 text-end">
                                    @prod.Price
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(prod.ImageUrl))
                            {
                                <div class="text-center">
                                    <img class="card-img-top img-thumbnail img-rounded mt-2 w-50" src="@prod.ImageUrl" style="">
                                </div>
                            }
                            <div class="card-body">
                                <h5 class="card-title lead text-success text-center">@prod.Name</h5>
                                <p class="card-text mt-2">@((MarkupString)@prod.Description)</p>
                                <h4 class="text-center">
                                    <div class="m-auto p-2" @onclick="() => addOrderItem(prod)">
                                    <i class="bi bi-cart3 btn btn-success form-control px-5 text-right" style="width:300px"> Add to cart</i>
                                    </div>
                                </h4>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
@code {
    public bool isProcessing { get; set; } = true;
    private int selectedCategoryId = 0;
    private string searchText = "";

    private IEnumerable<Product> Products { get; set; } = new List<Product>();
    private IEnumerable<Category> Categories { get; set; } = new List<Category>();
    private IEnumerable<Product> FilteredProducts { get; set; } = new List<Product>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await loadProducts();
            isProcessing = false;
            StateHasChanged();
        }

    }

    private async Task loadProducts()
    {
        Products = await _productRepository.GetAllAsync();
        Categories = await _categoryRepository.GetAllAsync();
        await filteredProducts(0);
    }

    private async Task filteredProducts(int categoryId)
    {
        if (categoryId == 0)
        {
            FilteredProducts = Products;
            selectedCategoryId = categoryId;
        }
        else
        {
            FilteredProducts = Products.Where(u => u.CategoryId == categoryId).ToList();
            selectedCategoryId = categoryId;
            searchText = String.Empty;
        }

    }

    private void searchByProdName(string newsearchtext)
    {
        if (string.IsNullOrWhiteSpace(newsearchtext))
        {
            FilteredProducts = Products;
        }
        else
        {
            FilteredProducts = Products.Where(u => u.Name.Contains(newsearchtext, StringComparison.InvariantCultureIgnoreCase)).ToList();
        }
        searchText = newsearchtext;
    }

    private string getActiveTabClass(int categoryId)
    {
        return categoryId == selectedCategoryId ? "active" : String.Empty;
    }

    private async Task addOrderItem(Product product)
    {
        var authState = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var authenticated = user.Identity is not null && user.Identity.IsAuthenticated;

        if (!authenticated)
        {
            _navigationManager.NavigateTo("/Account/Login");
        }
        else
        {
            var userId = user.FindFirst(u => u.Type.Contains("nameidentifier"))?.Value;
            var result = await
            _cartRepository.UpadateCartAsync(userId, product.Id, 1);
            _sharedStateService.TotalCartCount = await _cartRepository.GetTotalCartItemCountAsync(userId);
            if (result)
            {
                _js?.ToastrSuccess("Order Added To Cart Successfully");
            }
            else
            {
                _js?.ToastrError("An error occured Adding Order To Cart");
            }
        }
    }
}
