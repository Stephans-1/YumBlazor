@page "/product/create"
@page "/product/update/{Id:int}"
@using YumBlazor.Components.Shared

@inject IProductRepository _productRepository
@inject ICategoryRepository _categoryRepository
@inject NavigationManager _navigationManager
@inject IWebHostEnvironment _hostEnvironment
@inject IJSRuntime _js

@if (isProcessing)
{
    <div class="position-absolute d-flex flex-column align-items-center justify-content-center h-75 w-75 bg-white">
        <img src="./images/loading.gif" alt="loading" />
    </div>
}
else
{
    <div class="card bordere-0 mt-4 shadow">
        <div class="card-header bg-gradient ml-0 bg-black py-1">
            <div class="row">
                <div class="col-20 text-center">
                    <h2 class="py-2 text-white">@(Id > 0 ? "Update " : "Create ")Product List</h2>
                </div>
            </div>
        </div>
        <div class="card-body p-4">
            <EditForm Model="product" FormName="Product" OnValidSubmit="UpsertProduct">
                <DataAnnotationsValidator />
                <div class="mt-4 border p-3">
                    <div class="form-floating col-12 py-3">
                        <InputText id="name" class="form-control" @bind-Value="product.Name" />
                        <label for="name">Name</label>
                        <ValidationMessage For="(() => product.Name)" />
                    </div>
                    <div class="form-floating col-12 py-3">
                        <InputText id="description" class="form-control" @bind-Value="product.Description" />
                        <label for="description">Description</label>
                        <ValidationMessage For="(() => product.Description)" />
                    </div>
                    <div class="form-floating col-12 py-3">
                    <InputText id="specialTag" class="form-control" @bind-Value="product.SpecialTag" />
                        <label for="specialTag">Special Tag</label>
                        <ValidationMessage For="(() => product.SpecialTag)" />
                </div>
                    <div class="form-floating col-12 py-3">
                        <InputNumber id="price" class="form-control" @bind-Value="product.Price" />
                        <label for="price">Price</label>
                        <ValidationMessage For="(() => product.Price)" />
                    </div>
                    <div class="form-floating col-12 py-3">
                        <InputSelect id="category" class="form-control" @bind-Value="product.CategoryId">
                            <option value="0" disabled selected>---Select a category---</option>
                            @foreach (var category in Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                        <label for="category">Category</label>
                        <ValidationMessage For="(() => product.CategoryId)" />
                    </div>
                    
                    <div class="form-floating col-12 py-3">
                        @if (product.ImageUrl is null)
                        {
                            <InputFile OnChange="loadFiles" id="customFile" class="form-control" @bind-Value="product.Name" accept="image/x-png, image/jpeg"></InputFile>
                            <label for="customFile"></label>
                            <ValidationMessage For="(() => product.ImageUrl)" />
                        }
                        @if (isImageLoading)
                        {
                            <div class="d-flex align-items-center mt-2">
                                <img src="./images/loading.gif" alt="loading" class="size-6" />
                                <span class="ms-2">Loading...</span>
                            </div>
                        }
                        else if (product.ImageUrl is not null)
                        {
                            <div class="row">
                                <div class="col-3 pt-3">
                                    <img src="@product.ImageUrl" alt="Product Image" class="img-thumbnail" />
                                </div>
                                <button class="btn btn-danger col-1" @onclick="removeImage" style="color:red">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                    </svg>
                                </button>
                            </div>
                            
                        }
                    </div>
                    <div class="row mt-3">
                        <div class="col-md-3 col-6">
                            <a href="product" class="btn btn-secondary" disabled="@isProcessing">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                                </svg>
                                Back
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <button type="submit" class="btn btn-primary" disabled="@isProcessing">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.75V16.5L12 14.25 7.5 16.5V3.75m9 0H18A2.25 2.25 0 0 1 20.25 6v12A2.25 2.25 0 0 1 18 20.25H6A2.25 2.25 0 0 1 3.75 18V6A2.25 2.25 0 0 1 6 3.75h1.5m9 0h-9" />
                                </svg>

                                @(Id > 0 ? "Update " : "Create ")
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

}

@code {
    [Parameter]
    public int Id { get; set; }
    [SupplyParameterFromForm(Name = "Product")]
    private Product product { get; set; } = new Product();

    private string? _directoryPath { get; set; }
    private bool isImageLoading { get; set; } = false;
    public bool isProcessing { get; set; } = true;
    public IEnumerable<Category> Categories { get; set; } = new List<Category>();

    protected override async Task OnInitializedAsync()
    {
        _directoryPath = Path.Combine(_hostEnvironment.WebRootPath, "images", "product");
        await base.OnInitializedAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await loadProductandCategory();
            isProcessing = false;
            StateHasChanged();
        }
    }
    private async Task loadProductandCategory()
    {
        if (Id > 0)
        {
            product = await _productRepository.Get(Id);
        }
        Categories = await _categoryRepository.GetAllAsync();
    }

    private async Task UpsertProduct()
    {
        isProcessing = true;
        if (Id == 0)
        {
            //create
            await _productRepository.CreateAsync(product);
            await _js.ToastrSuccess("Product Created Successfully");
        }
        else
        {
            //update
            await _productRepository.UpdateAsync(product);
            await _js.ToastrSuccess("Product Updated Successfully");
        }
        isProcessing = false;
        _navigationManager.NavigateTo("product");
    }
    private async Task loadFiles(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        var file = e.File;
        //uploaded file with file name
        FileInfo fileInfo = new(file.Name);
        //saved file with new name
        var newFileName = $"{Guid.NewGuid()}.{fileInfo.Extension}";

        if (!Directory.Exists(_directoryPath))
        {
            Directory.CreateDirectory(_directoryPath);
        }
        var path = Path.Combine(_directoryPath, newFileName);

        await using FileStream fileStream = new(path, FileMode.Create);
        await file.OpenReadStream(file.Size).CopyToAsync(fileStream);
        product.ImageUrl = $"/images/product/{newFileName}";
        isProcessing = false;
        isImageLoading = false;
    }

    void removeImage()
    {
        var fileToDelete = product.ImageUrl.Split('/').Reverse().First();

        var filePathToDeletImage = Path.Combine(_directoryPath, fileToDelete);

        if (File.Exists(filePathToDeletImage))
        {
            File.Delete(filePathToDeletImage);
        }
            product.ImageUrl = null;
            return;
        }
    }

