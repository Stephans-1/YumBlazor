@using YumBlazor.Utility
@inherits LayoutComponentBase
@inject AuthenticationStateProvider _authenticationStateProvider

<div class="page">
    <AuthorizeView Roles="@SD.Role_Admin">
        <div class="sidebar">
            <NavMenu />
        </div>
    </AuthorizeView>
    <main>
        @if (_narBavVisible)
        {
            <NavBav></NavBav>
        }
            @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _narBavVisible;
    protected override async Task OnInitializedAsync()
    {
        _narBavVisible = await showNavBar();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _narBavVisible = await showNavBar();
    }

    private async Task<bool> showNavBar()
    {
        var authSate = await _authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authSate.User;
        var authenticated = user.Identity is not null && user.Identity.IsAuthenticated;

        if (!authenticated)
        {
            return true;
        }

        if (user.IsInRole(SD.Role_Admin))
        {
            return true;
        }
        return false;
    }
}