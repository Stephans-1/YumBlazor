@using YumBlazor.Components.Pages.Product_Pages

<nav class="navbar navbar-expand-md navbar-dark bg-dark pt-4 pb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="/images/Logo.png" alt="Bootstrap" width="30" height="24">
            YumBlazor
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse" id="navbarCollapse">
            <ul class="navbar-nav mb-md-0 me-auto mb-2">
                <li class="nav-item">
                    <NavLink class="nav-link d-flex align-items-center gap-2" href="">
                        <span class="bi bi-house-door" aria-hidden="true"></span>
                        <span>Home</span>
                    </NavLink>
                </li>
                
                <li class="nav-item mx-2">
                    <NavLink class="nav-link d-flex align-items-center gap-1" href="/cart">
                        <span>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                            </svg>
                        </span>
                        <span>Cart</span>
                    </NavLink>
                </li>
            </ul>
            
            <ul class="d-flex navbar-nav mb-md-0 mb-2">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item">
                            <button class="nav-link active me-2" style="cursor: pointer; background: transparent; border: 0px;">
                                Welcome, @context?.User?.Identity?.Name
                            </button>
                        </li>
                        <li class="nav-item">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit" class="nav-link btn btn-success d-flex align-items-center gap-2">
                                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                                </button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Register">
                                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link btn btn-success d-flex align-items-center gap-2" href="Account/Login">
                                <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</nav>

@code {
    private bool addedProduct = false;
}